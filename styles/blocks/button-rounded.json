{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Rounded",
	"slug": "rounded",
	"blockTypes": [ "core/button" ],
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--secondary)",
			"text": "var(--wp--preset--color--text-white)"
		},
		"border": {
			"radius": "24px"
		},
		"spacing": {
			"padding": {
				"top": "12px",
				"right": "32px",
				"bottom": "12px",
				"left": "32px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--button-small)",
			"fontWeight": "500",
			"lineHeight": "var(--wp--custom--line-height--button-small)"
		},
		":hover": {
			"color": {
				"background": "var(--wp--preset--color--primary)",
				"text": "var(--wp--preset--color--text-white)"
			}
		},
		":focus": {
			"color": {
				"background": "var(--wp--preset--color--primary)",
				"text": "var(--wp--preset--color--text-white)"
			}
		}
	}
}
