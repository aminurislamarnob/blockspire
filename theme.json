{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "800px",
			"wideSize": "1170px"
		},
        "border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
            "units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"name": "10px",
					"size": "10px",
					"slug": "10"
				},
				{
					"name": "20px",
					"size": "20px",
					"slug": "20"
				},
				{
					"name": "30px",
					"size": "30px",
					"slug": "30"
				},
				{
					"name": "50px",
					"size": "50px",
					"slug": "50"
				},
				{
					"name": "60px",
					"size": "60px",
					"slug": "60"
				},
				{
					"name": "70px",
					"size": "70px",
					"slug": "70"
				},
				{
					"name": "100px",
					"size": "100px",
					"slug": "100"
				}
			]
		},
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"position": {
			"sticky": true
		},
		"dimensions": {
			"minHeight": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#007CF5"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#12141D"
				},
				{
					"name": "Main BG",
					"slug": "main-bg",
					"color": "#ffffff"
				},
				{
					"name": "Light BG",
					"slug": "light-bg",
					"color": "#F4F4F4"
				},
				{
					"name": "Dark BG",
					"slug": "dark-bg",
					"color": "#12141D"
				},
				{
					"name": "Heading Color",
					"slug": "heading-color",
					"color": "#12141D"
				},
				{
					"name": "Text White",
					"slug": "text-white",
					"color": "#ffffff"
				},
				{
					"name": "Text Color",
					"slug": "text-color",
					"color": "#626368"
				},
				{
					"name": "Link Color",
					"slug": "link-color",
					"color": "#12141D"
				}
			]
		},
		"typography": {
			"fontStyles": true,
			"fontWeight": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"textDecoration": true,
			"textAlign": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"name": "Poppins",
					"slug": "poppins",
					"fontFamily": "'Poppins', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/Poppins-Regular.ttf"]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "500",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/Poppins-Medium.ttf"]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/Poppins-SemiBold.ttf"]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": ["file:./assets/fonts/Poppins-Bold.ttf"]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Small Paragraph",
					"slug": "small-paragraph",
					"size": "14px"
				},
				{
					"name": "Medium Paragraph",
					"slug": "medium-paragraph",
					"size": "16px"
				},
				{
					"name": "Large Paragraph",
					"slug": "large-paragraph",
					"size": "18px"
				},
				{
					"name": "Small Title",
					"slug": "small-title",
					"size": "16px"
				},
				{
					"name": "Medium Title",
					"slug": "medium-title",
					"size": "20px"
				},
				{
					"name": "Large Title",
					"slug": "large-title",
					"size": "24px"
				},
				{
					"name": "Heading 01",
					"slug": "heading-01",
					"size": "94px"
				},
				{
					"name": "Heading 02",
					"slug": "heading-02",
					"size": "72px"
				},
				{
					"name": "Heading 03",
					"slug": "heading-03",
					"size": "60px"
				},
				{
					"name": "Heading 04",
					"slug": "heading-04",
					"size": "48px"
				},
				{
					"name": "Heading 05",
					"slug": "heading-05",
					"size": "36px",
					"lineHeight": "42px",
					"fontWeight": "700"
				},
				{
					"name": "Heading 06",
					"slug": "heading-06",
					"size": "30px"
				},
				{
					"name": "Button Large",
					"slug": "button-large",
					"size": "16px"
				},
				{
					"name": "Button Small",
					"slug": "button-small",
					"size": "14px"
				}
			]
		}
    },
	"styles": {
		"color": {
			"text": "var(--wp--preset--color--text-color)"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"padding-top": "0px",
				"padding-right": "0px",
				"padding-bottom": "0px",
				"padding-left": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium-paragraph)",
			"fontWeight": "400",
			"lineHeight": "28px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				},
				":hover":{
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":active":{
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--text-white)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover":{
					"color": {
						"text": "var(--wp--preset--color--text-white)",
						"background": "var(--wp--preset--color--dark-bg)"
					}
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"bottom": "16px",
						"left": "32px",
						"right": "32px",
						"top": "16px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontWeight": "700",
					"lineHeight": "20px"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--medium-title)",
					"fontWeight": "700"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-01)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-02)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-03)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-04)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-05)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-06)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading-color)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"spacing": {
					"blockGap": "32px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "600"
				},
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				}
			}
		}
	}
}