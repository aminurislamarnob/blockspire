{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1170px"
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"position": {
			"sticky": true
		},
		"dimensions": {
			"minHeight": true
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"name": "10px",
					"size": "10px",
					"slug": "10"
				},
				{
					"name": "12px",
					"size": "12px",
					"slug": "12"
				},
				{
					"name": "16px",
					"size": "16px",
					"slug": "16"
				},
				{
					"name": "20px",
					"size": "20px",
					"slug": "20"
				},
				{
					"name": "24px",
					"size": "24px",
					"slug": "24"
				},
				{
					"name": "30px",
					"size": "30px",
					"slug": "30"
				},
				{
					"name": "32px",
					"size": "32px",
					"slug": "32"
				},
				{
					"name": "40px",
					"size": "40px",
					"slug": "40"
				},
				{
					"name": "48px",
					"size": "48px",
					"slug": "48"
				},
				{
					"name": "50px",
					"size": "50px",
					"slug": "50"
				},
				{
					"name": "60px",
					"size": "60px",
					"slug": "60"
				},
				{
					"name": "70px",
					"size": "70px",
					"slug": "70"
				},
				{
					"name": "80px",
					"size": "80px",
					"slug": "80"
				},
				{
					"name": "100px",
					"size": "100px",
					"slug": "100"
				},
				{
					"name": "Fluid inset",
					"size": "clamp(24px, 8.5vw, 100px)",
					"slug": "fluid-inset"
				}
			]
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#2D5BDB"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#FF9808"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#111B3A"
				},
				{
					"name": "Main BG",
					"slug": "main-bg",
					"color": "#FFFFFF"
				},
				{
					"name": "Light BG",
					"slug": "light-bg",
					"color": "#F4F4F4"
				},
				{
					"name": "Dark BG",
					"slug": "dark-bg",
					"color": "#111111"
				},
				{
					"name": "Heading Color",
					"slug": "heading-color",
					"color": "#111B3A"
				},
				{
					"name": "Text White",
					"slug": "text-white",
					"color": "#FFFFFF"
				},
				{
					"name": "Text Color",
					"slug": "text-color",
					"color": "#626368"
				},
				{
					"name": "Gray 02",
					"slug": "gray-02",
					"color": "#8D8D8D"
				},
				{
					"name": "Gray 03",
					"slug": "gray-03",
					"color": "#C6C6C6"
				},
				{
					"name": "Link Color",
					"slug": "link-color",
					"color": "#111B3A"
				}
			]
		},
		"typography": {
			"fontStyle": true,
			"fontWeight": true,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"textDecoration": true,
			"textAlign": true,
			"writingMode": true,
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Poppins",
					"slug": "poppins",
					"fontFamily": "'Poppins', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Poppins",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Poppins-Regular.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "500",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Poppins-Medium.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Poppins-SemiBold.woff2"
							]
						},
						{
							"fontFamily": "Poppins",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/Poppins-Bold.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"name": "Display",
					"slug": "display",
					"size": "64px",
					"fluid": {
						"min": "36px",
						"max": "64px"
					}
				},
				{
					"name": "Small Paragraph",
					"slug": "small-paragraph",
					"size": "14px"
				},
				{
					"name": "Medium Paragraph",
					"slug": "medium-paragraph",
					"size": "16px"
				},
				{
					"name": "Large Paragraph",
					"slug": "large-paragraph",
					"size": "18px"
				},
				{
					"name": "Small Title",
					"slug": "small-title",
					"size": "16px"
				},
				{
					"name": "Medium Title",
					"slug": "medium-title",
					"size": "20px"
				},
				{
					"name": "Large Title",
					"slug": "large-title",
					"size": "24px",
					"fluid": {
						"min": "20px",
						"max": "24px"
					}
				},
				{
					"name": "Heading 01",
					"slug": "heading-01",
					"size": "94px",
					"fluid": {
						"min": "40px",
						"max": "94px"
					}
				},
				{
					"name": "Heading 02",
					"slug": "heading-02",
					"size": "72px",
					"fluid": {
						"min": "36px",
						"max": "72px"
					}
				},
				{
					"name": "Heading 03",
					"slug": "heading-03",
					"size": "60px",
					"fluid": {
						"min": "32px",
						"max": "60px"
					}
				},
				{
					"name": "Heading 04",
					"slug": "heading-04",
					"size": "48px",
					"fluid": {
						"min": "28px",
						"max": "48px"
					}
				},
				{
					"name": "Heading 05",
					"slug": "heading-05",
					"size": "36px",
					"fluid": {
						"min": "26px",
						"max": "36px"
					}
				},
				{
					"name": "Heading 06",
					"slug": "heading-06",
					"size": "30px",
					"fluid": {
						"min": "24px",
						"max": "30px"
					}
				},
				{
					"name": "Button Large",
					"slug": "button-large",
					"size": "16px"
				},
				{
					"name": "Button Small",
					"slug": "button-small",
					"size": "14px"
				}
			]
		},
		"custom": {
			"lineHeight": {
				"display": "1",
				"heading-01": "1.064",
				"heading-02": "1.056",
				"heading-03": "1.067",
				"heading-04": "1.083",
				"heading-05": "1.167",
				"heading-06": "1.2",
				"title-large": "1.25",
				"title-medium": "1.3",
				"title-small": "1.625",
				"paragraph-large": "1.556",
				"paragraph-medium": "1.75",
				"paragraph-small": "1.571",
				"button-large": "1.25",
				"button-small": "1.429"
			},
			"fontWeight": {
				"regular": "400",
				"medium": "500",
				"semibold": "600",
				"bold": "700"
			},
			"letterSpacing": {
				"tight": "-0.03em"
			}
		}
	},
	"styles": {
		"css": ":where(a:not(.wp-element-button),.wp-element-button,.wp-block-button__link,input,button,textarea,select):focus{outline:none}\n:where(.wp-element-button,.wp-block-button__link,a:not(.wp-element-button)):focus-visible{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:0.25em}",
		"color": {
			"background": "var(--wp--preset--color--main-bg)",
			"text": "var(--wp--preset--color--text-color)"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"top": "0px",
				"right": "var:preset|spacing|20",
				"bottom": "0px",
				"left": "var:preset|spacing|20"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--poppins)",
			"fontSize": "var(--wp--preset--font-size--medium-paragraph)",
			"fontWeight": "400",
			"lineHeight": "var(--wp--custom--line-height--paragraph-medium)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				},
				":active": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--text-white)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--text-white)",
						"background": "var(--wp--preset--color--dark-bg)"
					}
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "16px",
						"right": "32px",
						"bottom": "16px",
						"left": "32px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--button-large)"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--text-color)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontSize": "var(--wp--preset--font-size--small-paragraph)",
					"fontWeight": "400",
					"lineHeight": "var(--wp--custom--line-height--paragraph-small)"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--heading-color)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "700"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-01)",
					"lineHeight": "var(--wp--custom--line-height--heading-01)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-02)",
					"lineHeight": "var(--wp--custom--line-height--heading-02)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-03)",
					"lineHeight": "var(--wp--custom--line-height--heading-03)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-04)",
					"lineHeight": "var(--wp--custom--line-height--heading-04)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-05)",
					"lineHeight": "var(--wp--custom--line-height--heading-05)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-06)",
					"lineHeight": "var(--wp--custom--line-height--heading-06)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"spacing": {
					"blockGap": "32px"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--button-large)",
					"fontFamily": "var(--wp--preset--font-family--poppins)",
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--button-large)"
				},
				"color": {
					"text": "var(--wp--preset--color--link-color)"
				},
				"css": "& .current-menu-item > .wp-block-navigation-item__content{text-decoration:underline;text-underline-offset:0.2em}"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
