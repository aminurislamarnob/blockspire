#: patterns/faq.php
msgctxt "Pattern title"
msgid "Frequently asked questions"
msgstr ""

#: patterns/faq.php
msgctxt "Pattern description"
msgid "A stack of expandable questions and answers built on the Details block, so it works without any JavaScript."
